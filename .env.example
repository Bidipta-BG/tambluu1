# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Find these in your Supabase project settings -> API.
# Required for Supabase Auth, direct DB queries, and Realtime Subscriptions.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# -----------------------------------------------------------------------------
# Custom Backend Engine
# -----------------------------------------------------------------------------
# The Tambola backend engine API URL that handles the business logic (ticketing, 
# game engine, booking).
NEXT_PUBLIC_API_BASE_URL="https://api.your-backend.com"

# -----------------------------------------------------------------------------
# Vercel Environment (Optional/Automatic)
# -----------------------------------------------------------------------------
# Automatically populated by Vercel in preview/production deployments. 
# Our middleware uses VERCEL_ENV to determine if it should trust preview domains 
# as local dev domains instead of trying to resolve them as actual tenants.
# VERCEL_ENV="development" # or "preview" or "production"
